#!/usr/bin/env sh
# ============================================================
# PRE-PUSH — runs before every git push
# Runs a production build to ensure nothing is broken
# before the code reaches the remote.
# ============================================================

echo "🏗️  Running pre-push build check…"

# ── 1. Build frontend ────────────────────────────────────────
echo "→ Building Frontend-portfolio (Vite)…"
(cd Frontend-portfolio && npm run build)
build_exit=$?

if [ $build_exit -ne 0 ]; then
  echo "✖ Frontend build failed. Fix the errors above before pushing."
  exit 1
fi

echo "✔ Pre-push checks passed — pushing code."
